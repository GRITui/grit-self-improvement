NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service-role key (Project Settings -> API). Server-only, never expose to
# the client — used by the Stripe webhook handler and the check-in AI
# analysis step to write rows with no coach session to authenticate as.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Dashboard -> Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# Anthropic (console.anthropic.com) — used to summarize check-ins, flag
# disengagement risk, and draft a suggested coach reply.
ANTHROPIC_API_KEY=
