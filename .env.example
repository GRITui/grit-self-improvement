# Neon Auth (Neon console -> Auth tab on your project, which provisions a
# Stack Auth project under the hood -- see supabase/README.md). Public keys
# are safe to expose to the browser; the secret key is server-only.
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Postgres -- the coaches/clients/checkins tables still live here
# until TSK-021 migrates them to Neon Postgres. Auth no longer uses
# Supabase at all (see Neon Auth vars above); these are used only for
# direct table access now (see src/lib/supabase/data.ts). The anon key is
# still used (unauthenticated) by the public tokenized check-in flow, which
# calls two SECURITY DEFINER Postgres functions that never relied on
# Supabase Auth in the first place -- see supabase/README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (Project Settings -> API). Server-only, never expose to
# the client. Used for every coach-scoped dashboard query -- now that
# sessions are Neon Auth sessions instead of Supabase ones, Supabase's RLS
# (`auth.uid() = coach_id`) can no longer authenticate requests, so
# src/lib/supabase/data.ts uses this key and each call site applies its own
# explicit `coach_id` filter instead. Also still used by the Stripe webhook
# handler and the check-in AI analysis step.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Dashboard -> Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# Anthropic (console.anthropic.com) — used to summarize check-ins, flag
# disengagement risk, and draft a suggested coach reply.
ANTHROPIC_API_KEY=
